# Copy this file to `.env` (exact name, nothing before the dot) and fill in
# your real keys. The `.env` file is listed in .gitignore and is NEVER
# committed — it stays on your machine only.

# ElevenLabs — from elevenlabs.io -> profile icon -> API Keys (Wave 3)
ELEVENLABS_API_KEY=paste_your_key_here

# OpenAI — from platform.openai.com -> API keys (needed in Wave 4, the summarizer)
OPENAI_API_KEY=paste_your_key_here
