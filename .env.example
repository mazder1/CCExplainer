# Copy this file to `.env` (exact name, nothing before the dot) and fill in
# your real keys. The `.env` file is listed in .gitignore and is NEVER
# committed — it stays on your machine only.

# ElevenLabs — from elevenlabs.io -> profile icon -> API Keys (Wave 3)
ELEVENLABS_API_KEY=paste_your_key_here

# --- The brain (language model) --------------------------------------------
# Default provider is OpenAI — just set this one and you're done:
OPENAI_API_KEY=paste_your_key_here

# OR use any other OpenAI-compatible provider by setting all three LLM_*
# values (they take precedence over OPENAI_API_KEY). Recipes:
#
# Kimi (Moonshot):
#   LLM_BASE_URL=https://api.moonshot.ai/v1
#   LLM_API_KEY=your_moonshot_key
#   LLM_MODEL=kimi-k2-0905-preview
#
# Anthropic Claude (via their OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_API_KEY=your_anthropic_key
#   LLM_MODEL=claude-haiku-4-5
#
# Local & free via Ollama (no key needed beyond a placeholder):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
#
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
